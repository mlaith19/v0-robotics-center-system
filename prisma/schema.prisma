generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id     String  @id @default(cuid())
  name   String
  email  String? @unique
  phone  String?
  status String  @default("מתעניין")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
}

model Teacher {
  id    String  @id @default(cuid())
  name  String
  email String? @unique
  phone String?

  // ✅ שדות מה-VO (לפי התמונות)
  status      String  @default("פעיל")
  idNumber    String?
  birthDate   DateTime?
  city        String?
  specialties String?
  notes       String?

  // ✅ תעריפים (לפי התמונות)
  rateCenter   Int?
  rateTravel   Int?
  rateExternal Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseLinks CourseTeacher[]
}

model Course {
  id          String  @id @default(cuid())
  title       String
  description String?
  price       Int?
  isActive    Boolean @default(true)

  duration  String?
  level     String?
  status    String?
  startDate DateTime?
  endDate   DateTime?
  startTime String?
  endTime   String?
  weekdays  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments  Enrollment[]
  teacherLinks CourseTeacher[]
}

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  studentId String
  courseId  String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

model CourseTeacher {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  courseId  String
  teacherId String

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([courseId])
  @@index([teacherId])
}
